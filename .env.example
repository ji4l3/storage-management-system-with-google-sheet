# API Configuration
# Copy this file to .env and update with your actual values.
# Do not commit .env.

# Your Google Apps Script Web App URL
EXPO_PUBLIC_API_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Your API Token
EXPO_PUBLIC_API_TOKEN=YOUR_API_TOKEN

# Optional API key, if your Apps Script checks it
EXPO_PUBLIC_API_KEY=YOUR_API_KEY

# Demo/internal login defaults
EXPO_PUBLIC_DEMO_USERNAME=demo
EXPO_PUBLIC_DEMO_PASSWORD=demo123
